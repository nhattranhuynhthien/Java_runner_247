events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    client_max_body_size 50M;

    # Enable Gzip compression to speed up script downloads 4x
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    server {
        listen ${PORT};
        server_name _;

        root /usr/share/novnc;
        index index.html;

        # Cache static scripts, images and styles in browser
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
            expires 30d;
            add_header Cache-Control "public, max-age=2592000, immutable";
            try_files $uri =404;
        }

        # Main Web Entry
        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-cache";
        }

        # UptimeRobot Health-check (ultra-fast 1ms response)
        location = /health {
            default_type application/json;
            return 200 '{"status":"alive","game":"J2ME Cloud 24/24"}';
        }

        # Real-time WebSocket Proxy with ZERO buffering and instant packet delivery
        location /websockify {
            proxy_pass http://127.0.0.1:6080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            
            # Disable buffering for instantaneous real-time streaming
            proxy_buffering off;
            proxy_cache off;
            tcp_nodelay on;

            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # Game File Uploader API
        location /api/ {
            proxy_pass http://127.0.0.1:5000;
            proxy_read_timeout 120s;
            client_max_body_size 50M;
        }
    }
}
